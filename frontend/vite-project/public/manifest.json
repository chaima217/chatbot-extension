{
  "manifest_version": 3,
  "name": "ChromeAI Assistant",
  "version": "1.0",
  "action": { 
    "default_popup": "popup.html" 
  },
  "permissions": ["storage"],
  "host_permissions": [
  "http://localhost:5173/*",
  "http://127.0.0.1:5173/*",
  "http://localhost:5001/*",
  "http://127.0.0.1:5001/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "index.js", "inject.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}